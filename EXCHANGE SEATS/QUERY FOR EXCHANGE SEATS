SELECT 
    CASE 
        -- If id is odd and it's the last student, keep id as is
        WHEN id % 2 = 1 AND id = (SELECT COUNT(*) FROM Seat) THEN id
        -- If id is odd, swap with next student (id + 1)
        WHEN id % 2 = 1 THEN id + 1
        -- If id is even, swap with previous student (id - 1)
        ELSE id - 1
    END AS id,
    student
FROM 
    Seat
ORDER BY 
    id ASC;